# Database MySQL (Hostinger: hPanel > Databases > Management)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u711122796_novelhkgroup18
DB_USER=u711122796_novelhkgroup
DB_PASSWORD=isi_password_database

# Akun pemilik (satu-satunya akun admin)
ADMIN_EMAIL=email@kamu.com
# Buat dengan: npm run hash -- "kata-sandi-kamu"
# Di file .env, tiap "$" harus ditulis "\$". Di panel env Hostinger, tempel apa adanya.
ADMIN_PASSWORD_HASH=
# String acak panjang (min 32 karakter) untuk menandatangani cookie sesi
SESSION_SECRET=

# Tokoh utama (pesan HP-nya tampil di kanan). Pisahkan koma bila lebih dari satu.
MAIN_CHARACTERS=Ethan
